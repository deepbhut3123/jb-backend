PORT=5000
CLIENT_URL=http://localhost:5173
# Add multiple allowed frontend URLs as a comma-separated list when needed.
# CLIENT_URL=https://testing.example.com,https://production.example.com
# Vercel preview deployments for this frontend project and team are allowed.
FRONTEND_VERCEL_PROJECT=jb-frontend
FRONTEND_VERCEL_SCOPE=deep-bhuts-projects
MONGODB_URI=mongodb://127.0.0.1:27017/jb-corporations
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
OTP_EXPIRY_MINUTES=10
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-mailbox@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=JB Corporation CRM <your-mailbox@gmail.com>
EMAIL_LOGO_URL=https://your-domain.com/jb-corporation-logo.png
# Optional: persistent folder for the WhatsApp linked-device session.
# WHATSAPP_AUTH_PATH=/persistent/whatsapp-session
# Optional: Chrome executable if using a system installation.
# WHATSAPP_CHROME_PATH=/usr/bin/google-chrome
